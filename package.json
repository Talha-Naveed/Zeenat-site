    "check": "npm run lint && npm run typecheck && npm test && npm run validate:seo && npm run build"
  },
  "dependencies": {
    "@vercel/analytics": "^1.5.0",
    "lucide-react": "^0.468.0",
    "next": "^16.3.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "shiki": "^3.12.2",
    "zeenat": "0.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.3.2",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.19"
  }
