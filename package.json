{
  "name": "zeenat-site",
  "version": "0.1.0",
  "private": true,
  "description": "The official Zeenat.js website and documentation portal.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:seo": "tsx scripts/validate-seo.ts",
